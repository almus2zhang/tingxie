# ==========================================
# 单词听写兼记忆平台 环境配置模板
# 复制本文件为 .env 并填入对应参数
# ==========================================

# 1. QQ 邮箱 SMTP 配置 (用于注册与找回密码验证码发送)
# 请前往 QQ 邮箱网页端 -> 设置 -> 账户 -> 开启 POP3/IMAP/SMTP 服务 -> 生成 16 位授权码
QQ_USER=your_qq_email@qq.com
QQ_PASS=your_16_digit_smtp_auth_code

# SMTP 服务器配置 (默认 QQ 邮箱 SSL 端口 465)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465

# 2. 硅基流动 (SiliconFlow) 视觉多模态大模型 API Key (可选系统默认)
SILICONFLOW_API_KEY=

# 3. JWT 用户鉴权密钥
JWT_SECRET=tingxie_super_secret_jwt_key_2026

# 4. 服务运行端口 (默认 1234)
PORT=1234
