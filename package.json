{
  "name": "tingxie-vocab-master",
  "version": "1.0.0",
  "description": "单词听写兼记忆网站 - 权威真人发音、AI 拍照识别、顺序听写与录音打分",
  "scripts": {
    "start": "node server/src/index.js",
    "build": "cd client && npm run build",
    "server": "node server/src/index.js",
    "client": "cd client && npm run dev",
    "service:status": "powershell -ExecutionPolicy Bypass -File scripts/service.ps1 status",
    "service:start": "powershell -ExecutionPolicy Bypass -File scripts/service.ps1 start",
    "service:stop": "powershell -ExecutionPolicy Bypass -File scripts/service.ps1 stop",
    "service:restart": "powershell -ExecutionPolicy Bypass -File scripts/service.ps1 restart",
    "service:install": "powershell -ExecutionPolicy Bypass -File scripts/service.ps1 install",
    "service:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/service.ps1 uninstall"
  },
  "keywords": [
    "dictation",
    "vocabulary",
    "pronunciation",
    "speech-recognition",
    "siliconflow-ai"
  ],
  "author": "",
  "license": "MIT"
}
